# Портове на хоста
FRONTEND_PORT=8080
API_PORT=8000

# PostgreSQL — не сменяй тези стойности при миграция на съществуващата база
POSTGRES_DB=candles
POSTGRES_USER=candles
POSTGRES_PASSWORD=change_me
POSTGRES_VOLUME_NAME=service_postgres_data

# Остави празно за локална употреба; за API защита задай дълъг случаен ключ
API_KEY=
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REQUEST_TIMEOUT=15
BINANCE_MAX_CONCURRENT_REQUESTS=3
BINANCE_BACKOFF_MAX_SECONDS=60
WATERMARK_SECONDS=120
RECONCILE_INTERVAL_SECONDS=300
RECOVERY_INTERVAL_SECONDS=60
HISTORY_BURST_DEFAULT=500
BACKFILL_BATCH_SIZE=1000
MAX_CANDLES_PER_REQUEST=5000
ACTIVE_SYMBOL_LIMIT=5
CLIENT_WS_HEARTBEAT_SECONDS=30
